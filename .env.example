# Copy to .env.local and fill in. Never commit real values.

# Public URL of this app, no trailing slash (local dev: http://localhost:3000)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Auth.js secret. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Postgres connection string (Neon serverless, https://neon.tech). Needs sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Stripe test keys, https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_

# Stripe webhook signing secret. Local: stripe listen --forward-to localhost:3000/api/stripe/subscription/webhook
STRIPE_WEBHOOK_SECRET=whsec_

# OAuth providers (optional, remove the buttons if you do not use them)
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Email (verification, password reset, two-factor codes) via Resend, https://resend.com
RESEND_API_KEY=
# Address mails are sent from (a domain verified in Resend) and where contact mails go
NEXT_PUBLIC_EMAIL_SENDER=
NEXT_PUBLIC_EMAIL_RECEIVER=
